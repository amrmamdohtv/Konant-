rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amrmamdoh22687@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Services collection
    match /services/{serviceId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.providerId == request.auth.uid || resource.data.requesterContact == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // Subscriptions collection
    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
